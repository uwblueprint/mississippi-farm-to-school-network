# Copy to `.env` in this repo root and fill in values.
# Both frontend (Vite envDir) and backend (loadEnv.ts) read this single file.

# --- Frontend (Vite public) ---
# Auth domain + project id must stay VITE_* (client-only).
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id

# --- Shared (canonical names) ---
# Vite bridges these into VITE_FIREBASE_API_KEY / VITE_FIREBASE_STORAGE_BUCKET /
# VITE_MAPBOX_ACCESS_TOKEN / VITE_PUBLIC_ADMIN_EMAIL_DOMAIN for the browser.
FIREBASE_WEB_API_KEY=your-web-api-key
# Use the bucket id from Firebase Console -> Storage (usually *.firebasestorage.app)
FIREBASE_STORAGE_DEFAULT_BUCKET=your-project.firebasestorage.app
MAPBOX_ACCESS_TOKEN=your-mapbox-token
# Comma-separated domains, no "@".
ADMIN_EMAIL_DOMAIN=example.com

# --- Backend ---
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
GRAPHQL_URL=http://localhost:3000/graphql

# Firebase Admin
# Option A (path to service-account JSON):
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccount.json

# Option B (inline credentials instead of A):
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_SVC_ACCOUNT_CLIENT_EMAIL=firebase-adminsdk-...@your-project.iam.gserviceaccount.com
# FIREBASE_SVC_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

FIREBASE_REQUEST_URI=http://localhost

# Email (optional, used to send farm notification emails)
# MAILER_USER=
# MAILER_CLIENT_ID=
# MAILER_CLIENT_SECRET=
# MAILER_REFRESH_TOKEN=

# Optional local-only admin auto-login helpers (frontend server)
# DEV_ADMIN_REFRESH_TOKEN=
# DEV_FIREBASE_WEB_API_KEY=
